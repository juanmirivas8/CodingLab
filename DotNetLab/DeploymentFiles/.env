# ===========================================
# Environment Variables for Docker Compose
# ===========================================
# INSTRUCTIONS:
# 1. This file is already a copy of .env.example
# 2. Replace the values below with your actual credentials
# 3. This file is in .gitignore and will NOT be committed to Git

# SQL Server Configuration
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Developer

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# RabbitMQ Application Configuration (for ASP.NET Core config override)
RabbitMq__UserName=guest
RabbitMq__Password=guest

# Application Configuration
ASPNETCORE_ENVIRONMENT=Docker
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=DotNetLab.Database;User Id=sa;Password=YourStrong@Passw0rd;MultipleActiveResultSets=true;TrustServerCertificate=true

# Note: The ConnectionStrings__DefaultConnection uses double underscore (__) 
# to represent the nested JSON structure:
# ConnectionStrings:
#   DefaultConnection: "value"
