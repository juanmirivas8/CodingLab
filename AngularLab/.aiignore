# An .aiignore file follows the same syntax as a .gitignore file.
# .gitignore documentation: https://git-scm.com/docs/gitignore

# Dependencies
node_modules/

# Build outputs, compilation, and caches
dist/
build/
out/
.angular/
out-tsc/
bazel-out/

# Test coverage and test artifacts
coverage/
__screenshots__/
*.lcov

# Logs, debug files, and temporary files
*.log
*.tmp
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log

# IDEs and editors
.idea/
.vscode/
.history/
*.swp
*.swo

# Environment and secret files
.env
.env.*

# OS files
.DS_Store
Thumbs.db
