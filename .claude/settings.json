{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/local.settings.json)",
      "Read(**/secrets.json)",
      "Read(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/local.settings.json)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.angular/**)",
      "Read(**/coverage/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "codinglab": {
      "source": {
        "source": "directory",
        "path": "/home/juanmirivas8/Desktop/CodingLab/Course"
      }
    }
  },
  "enabledPlugins": {
    "ts-angular-course@codinglab": true
  }
}
